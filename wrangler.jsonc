{
  "name": "blogkub",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm ci && npm run build",
    "cwd": "site"
  },
  "assets": {
    "directory": "site/dist",
    "not_found_handling": "404-page"
  }
}
