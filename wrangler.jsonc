{
  // Deploys are driven by .github/workflows/deploy.yml, which builds the site
  // and then runs `wrangler deploy` to upload site/dist.
  //
  // There is deliberately no "build" block here. Wrangler runs it on every
  // `wrangler deploy`, which meant the site was built a second time inside the
  // deploy step, after the workflow had already built it. That rebuild re-ran
  // the postbuild chain, including the IndexNow planner, and a planner run
  // between the plan step and the submit step is exactly what silently emptied
  // a forced submission queue once already.
  //
  // If a build command is ever needed here again, check what happens when the
  // whole postbuild chain runs twice per deploy before adding it back.
  "name": "blogkub",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Contact form. Email Routing on this domain only RECEIVES, so the form needs its
  // own way to send; this binding is Email Workers, costs nothing, and can only
  // deliver to an address already verified on the account.
  //
  // No "destination_address" here on purpose. Pinning it would put a real mailbox in
  // a public repository. The recipient is read at runtime from CONTACT_TO, set with
  // `wrangler secret put CONTACT_TO` or as a Worker variable in the dashboard. Without
  // it the endpoint answers 503 "unconfigured" rather than pretending to send.
  "send_email": [
    { "name": "CONTACT_EMAIL" }
  ],
  "main": "worker/index.js",
  "assets": {
    "directory": "site/dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/learn/images/*", "!/learn/og/*", "!/blog/images/*", "!/*.png", "!/*.ico", "!/*.xml", "!/*.json", "!/*.txt", "!/*.webmanifest"]
  }
}
