const script = `<script>
(function () {
  var root = document.getElementById('cf');
  var form = document.getElementById('cfForm');
  if (!root || !form) return;

  // When the page finished rendering. The server rejects anything submitted within
  // three seconds of this, which no human beats and most bots do not clear.
  var born = Date.now();
  var topic = 'question';

  var els = {
    name: document.getElementById('cfName'),
    email: document.getElementById('cfEmail'),
    message: document.getElementById('cfMessage'),
    hp: document.getElementById('cfRef'),
    submit: document.getElementById('cfSubmit'),
    submitText: document.getElementById('cfSubmitText'),
    count: document.getElementById('cfCount'),
    alert: document.getElementById('cfAlert'),
    live: document.getElementById('cfLive'),
    done: document.getElementById('cfDone')
  };

  var MSG = {
    name: 'กรุณากรอกชื่อของคุณ',
    email: 'กรุณากรอกอีเมลให้ถูกต้อง',
    message: 'ข้อความสั้นเกินไป กรุณาเขียนอย่างน้อย 10 ตัวอักษร',
    network: 'ส่งไม่สำเร็จ กรุณาลองใหม่อีกครั้ง หรืออีเมลมาที่ hello@blogkub.com',
    unconfigured: 'ระบบส่งอีเมลยังไม่พร้อมใช้งาน กรุณาอีเมลมาที่ hello@blogkub.com โดยตรงครับ',
    invalid: 'กรุณาตรวจสอบข้อมูลที่กรอกอีกครั้ง'
  };

  function field(name) { return form.querySelector('[data-f="' + name + '"]'); }
  function setBad(name, text) {
    var f = field(name); if (!f) return;
    f.classList.add('is-bad');
    var m = f.querySelector('.cf-msg'); if (m) m.textContent = text || '';
    var input = f.querySelector('input,textarea'); if (input) input.setAttribute('aria-invalid', 'true');
  }
  function clearBad(name) {
    var f = field(name); if (!f) return;
    f.classList.remove('is-bad');
    var m = f.querySelector('.cf-msg'); if (m) m.textContent = '';
    var input = f.querySelector('input,textarea'); if (input) input.removeAttribute('aria-invalid');
  }

  // Float the label once a field has content, so it does not drop back over the text.
  ['name', 'email', 'message'].forEach(function (k) {
    var input = els[k];
    var wrap = field(k);
    function sync() { wrap.classList.toggle('is-filled', input.value.length > 0); }
    input.addEventListener('input', function () {
      sync();
      clearBad(k);
      if (k === 'message') {
        var n = input.value.length;
        els.count.textContent = n + ' / 4000';
        els.count.classList.toggle('warn', n > 3800);
      }
    });
    input.addEventListener('blur', sync);
    sync();
  });

  // Topic chips
  form.querySelectorAll('.cf-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      topic = chip.dataset.topic;
      form.querySelectorAll('.cf-chip').forEach(function (c) {
        c.setAttribute('aria-pressed', String(c === chip));
      });
    });
  });

  // Ripple from the point of contact.
  els.submit.addEventListener('pointerdown', function (e) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var r = els.submit.getBoundingClientRect();
    var d = Math.max(r.width, r.height);
    var ink = document.createElement('span');
    ink.className = 'ink';
    ink.style.width = ink.style.height = d + 'px';
    ink.style.left = (e.clientX - r.left - d / 2) + 'px';
    ink.style.top = (e.clientY - r.top - d / 2) + 'px';
    els.submit.appendChild(ink);
    setTimeout(function () { ink.remove(); }, 620);
  });

  function validate() {
    var ok = true;
    if (!els.name.value.trim()) { setBad('name', MSG.name); ok = false; }
    if (!/^[^\\s@]+@[^\\s@.]+(\\.[^\\s@.]+)+$/.test(els.email.value.trim())) { setBad('email', MSG.email); ok = false; }
    if (els.message.value.trim().length < 10) { setBad('message', MSG.message); ok = false; }
    return ok;
  }

  function fail(text) {
    root.classList.remove('is-sending');
    root.classList.add('is-error');
    els.alert.textContent = text;
    els.submit.disabled = false;
    els.submitText.textContent = 'ส่งข้อความ';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    root.classList.remove('is-error');
    els.alert.textContent = '';
    if (!validate()) {
      var firstBad = form.querySelector('.is-bad input,.is-bad textarea');
      if (firstBad) firstBad.focus();
      return;
    }

    root.classList.add('is-sending');
    els.submit.disabled = true;
    els.submitText.textContent = 'กำลังส่ง...';
    els.live.textContent = 'กำลังส่งข้อความ';

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: els.name.value,
        email: els.email.value,
        message: els.message.value,
        hp: els.hp.value,
        topic: topic,
        t: born,
        page: location.pathname
      })
    }).then(function (res) {
      return res.json().then(function (data) { return { status: res.status, data: data }; });
    }).then(function (r) {
      root.classList.remove('is-sending');
      els.live.textContent = '';
      if (r.data && r.data.ok) {
        root.classList.add('is-done');
        document.getElementById('cf').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
      if (r.data && r.data.error === 'unconfigured') return fail(MSG.unconfigured);
      if (r.data && r.data.error === 'invalid') {
        (r.data.fields || []).forEach(function (f) { setBad(f, MSG[f] || MSG.invalid); });
        return fail(MSG.invalid);
      }
      fail(MSG.network);
    }).catch(function () {
      els.live.textContent = '';
      fail(MSG.network);
    });
  });

  document.getElementById('cfAgain').addEventListener('click', function () {
    form.reset();
    ['name', 'email', 'message'].forEach(function (k) { clearBad(k); field(k).classList.remove('is-filled'); });
    els.count.textContent = '0 / 4000';
    els.count.classList.remove('warn');
    els.submit.disabled = false;
    els.submitText.textContent = 'ส่งข้อความ';
    born = Date.now();
    root.classList.remove('is-done');
    els.name.focus();
  });
})();
</script>`;

const article = `<main class="wrap"><article class="doc">
<nav class="crumb"><a href="/">หน้าแรก</a> › <span>ติดต่อเรา</span></nav>
<span class="pill">ติดต่อเรา</span>
<h1>มีคำถาม หรืออยาก <span class="g">เสนอแนะฟีเจอร์</span>?</h1>
<p class="lead">เรายินดีรับฟังทุกความคิดเห็นเสมอ ไม่ว่าจะเป็นการสอบถามวิธีใช้งาน แจ้งปัญหาที่พบ เสนอไอเดียฟีเจอร์ใหม่ หรือพูดคุยเรื่องความร่วมมือ ทีมงาน BlogKub อ่านทุกข้อความและตั้งใจตอบกลับให้เร็วที่สุด</p>

${styles}
${form}

<h2>ช่องทางอื่น</h2>
<div class="channels">
  <div class="ch"><div class="ic">✉️</div><b>อีเมล</b><a href="mailto:hello@blogkub.com">hello@blogkub.com</a></div>
  <div class="ch"><div class="ic">💬</div><b>Facebook</b><a href="https://www.facebook.com/patpisan" target="_blank" rel="noopener">ผู้ก่อตั้ง (เบน)</a></div>
  <div class="ch"><div class="ic">🗨️</div><b>Pantip</b><a href="https://pantip.com/profile/2448725" target="_blank" rel="noopener">LuMoo (ลูโม)</a></div>
  <div class="ch"><div class="ic">📚</div><b>ศูนย์เรียนรู้</b><a href="/learn/">อ่านคู่มือการใช้งาน</a></div>
  <div class="ch"><div class="ic">🛠️</div><b>ลองใช้เครื่องมือ</b><a href="/builder">เปิด BlogKub Builder</a></div>
</div>

<h2>เรื่องที่ติดต่อเราได้</h2>
<ul>
  <li><strong>สอบถามการใช้งาน</strong> — ไม่แน่ใจว่าฟีเจอร์ไหนทำงานอย่างไร หรือทำสิ่งที่ต้องการได้ไหม</li>
  <li><strong>แจ้งปัญหา (bug)</strong> — พบข้อผิดพลาด ไฟล์ที่ export มีปัญหา หรือการแสดงผลผิดเพี้ยน</li>
  <li><strong>เสนอฟีเจอร์</strong> — อยากให้ BlogKub มีบล็อก เทมเพลต หรือความสามารถใหม่ ๆ</li>
  <li><strong>ความร่วมมือและอื่น ๆ</strong> — สอบถามเรื่องการใช้งานร่วมกัน สื่อ หรือข้อเสนอแนะทั่วไป</li>
</ul>

<h2>ก่อนติดต่อ ลองดูสิ่งเหล่านี้ก่อน</h2>
<p>คำถามการใช้งานส่วนใหญ่มีคำตอบอยู่แล้วใน <a href="/learn/">ศูนย์เรียนรู้</a> ซึ่งรวมคู่มือทีละฟีเจอร์พร้อมภาพประกอบและวิธีทำทีละขั้น เช่น <a href="/learn/toc">สารบัญอัตโนมัติ</a>, <a href="/learn/dark-mode">โหมดมืด</a>, <a href="/learn/aeo">กล่องสรุป AEO</a> และ <a href="/learn/templates">การเลือกเทมเพลต</a> ส่วนบทความเชิงลึกเรื่องการทำบล็อกให้ติดหน้าแรก Google และการหารายได้ อ่านได้ที่ <a href="/blog/">บล็อกของเรา</a></p>

<h2>เวลาในการตอบกลับ</h2>
<p>BlogKub ดูแลโดยทีมเล็ก เราอ่านทุกข้อความและตั้งใจตอบกลับภายในเวลาที่เหมาะสม แต่บางครั้งอาจใช้เวลาสักหน่อยในช่วงที่มีคำถามเข้ามาก การอธิบายปัญหาให้ชัดเจน (พร้อมภาพหน้าจอถ้ามี) จะช่วยให้เราช่วยคุณได้เร็วขึ้น</p>

<div class="note">ขอบคุณที่ใช้งานและสนับสนุน BlogKub ทุกความคิดเห็นของคุณคือแรงผลักดันให้เราพัฒนาเครื่องมือให้ดีขึ้นเรื่อย ๆ ครับ</div>
</article></main>
