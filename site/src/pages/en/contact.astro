---
import EnLayout from '../../layouts/EnLayout.astro';
const seo = `<meta name="robots" content="index, follow, max-image-preview:large">
<title>Contact BlogKub | Free Blogger theme builder</title>
<meta name="description" content="Get in touch with the BlogKub team. Ask a question, report a bug, or suggest a feature using the form, or email hello@blogkub.com. We read every message.">
<link rel="canonical" href="https://www.blogkub.com/en/contact">
<meta property="og:type" content="website">
<meta property="og:site_name" content="BlogKub">
<meta property="og:title" content="Contact BlogKub">
<meta property="og:description" content="Ask a question, report a bug, or suggest a feature for the BlogKub theme builder.">
<meta property="og:url" content="https://www.blogkub.com/en/contact">
<meta property="og:image" content="https://www.blogkub.com/android-chrome-512x512.png">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary">
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[
{"@type":"Organization","@id":"https://www.blogkub.com/#org","name":"BlogKub","url":"https://www.blogkub.com/","email":"hello@blogkub.com","logo":{"@type":"ImageObject","url":"https://www.blogkub.com/android-chrome-512x512.png","width":512,"height":512},"contactPoint":{"@type":"ContactPoint","contactType":"customer support","email":"hello@blogkub.com","availableLanguage":["th","en"]}},
{"@type":"ContactPage","@id":"https://www.blogkub.com/en/contact#webpage","url":"https://www.blogkub.com/en/contact","name":"Contact BlogKub","inLanguage":"en","isPartOf":{"@id":"https://www.blogkub.com/#website"}},
{"@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"https://www.blogkub.com/en/"},
{"@type":"ListItem","position":2,"name":"Contact"}]}
]}</script>`;

const styles = `<style>
/* Contact form. Prefixed .cf- so nothing here can reach the rest of the site, and
   built on the theme's own tokens so it follows light/dark without a second palette. */
.cf{--cf-ok:#22c55e;--cf-err:#f43f5e;margin:30px 0 8px;position:relative}
.cf-card{position:relative;background:var(--surface,#fff);border:1px solid var(--border,#e8eaf2);border-radius:20px;padding:0;overflow:hidden;transition:border-color .3s var(--ease,ease),box-shadow .3s var(--ease,ease)}
.cf-card:focus-within{border-color:var(--brand,#6366f1);box-shadow:0 0 0 4px color-mix(in srgb,var(--brand,#6366f1) 12%,transparent)}
.cf-card::before{content:"";position:absolute;inset:0 0 auto;height:3px;background:var(--grad,linear-gradient(120deg,#6366f1,#8b5cf6 50%,#ec4899));background-size:200% 100%;animation:cfSlide 8s linear infinite}
@keyframes cfSlide{to{background-position:200% 0}}
.cf-body{padding:26px 24px 24px}
.cf-head{margin-bottom:20px}
.cf-head h3{font-family:var(--font-display,inherit);font-size:20px;font-weight:700;margin:0 0 6px;color:var(--ink,#111)}
.cf-head p{margin:0;font-size:14.5px;color:var(--ink-3,#777)}

/* Topic chips */
.cf-topics{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.cf-chip{position:relative;border:1px solid var(--border,#e8eaf2);background:var(--surface-2,#f5f6fa);color:var(--ink-2,#555);border-radius:999px;padding:9px 16px;font:600 13.5px var(--font-body,inherit);cursor:pointer;transition:transform .18s var(--ease,ease),color .18s,border-color .18s,background .18s}
.cf-chip:hover{border-color:var(--brand,#6366f1);color:var(--ink,#111)}
.cf-chip:active{transform:scale(.94)}
.cf-chip[aria-pressed="true"]{background:var(--grad,#6366f1);border-color:transparent;color:#fff;box-shadow:0 6px 18px -6px var(--glow,rgba(99,102,241,.5))}

/* Floating-label fields */
.cf-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.cf-f{position:relative;margin-bottom:16px}
.cf-f input,.cf-f textarea{width:100%;font:400 15px/1.6 var(--font-body,inherit);color:var(--ink,#111);background:var(--bg-2,#fff);border:1px solid var(--border,#e8eaf2);border-radius:12px;padding:20px 14px 8px;outline:0;transition:border-color .2s,box-shadow .2s}
.cf-f textarea{min-height:132px;resize:vertical;padding-top:24px}
.cf-f input:focus,.cf-f textarea:focus{border-color:var(--brand,#6366f1);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand,#6366f1) 14%,transparent)}
.cf-f label{position:absolute;left:15px;top:15px;font-size:15px;color:var(--ink-3,#888);pointer-events:none;transform-origin:0 0;transition:transform .18s var(--ease,ease),color .18s}
.cf-f input:focus+label,.cf-f textarea:focus+label,.cf-f.is-filled label{transform:translateY(-8px) scale(.74);color:var(--brand,#6366f1)}
.cf-f.is-bad input,.cf-f.is-bad textarea{border-color:var(--cf-err)}
.cf-f.is-bad label{color:var(--cf-err)}
.cf-msg{display:block;min-height:16px;margin:5px 2px 0;font-size:12.5px;color:var(--cf-err);opacity:0;transform:translateY(-3px);transition:opacity .2s,transform .2s}
.cf-f.is-bad .cf-msg{opacity:1;transform:none}
.cf-count{position:absolute;right:12px;bottom:10px;font:600 11.5px var(--font-mono,monospace);color:var(--ink-3,#999);background:var(--bg-2,#fff);padding:0 4px;border-radius:5px}
.cf-count.warn{color:var(--cf-err)}

/* Honeypot: off-screen, never announced, never tabbed to. */
.cf-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

/* Submit */
.cf-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:4px}
.cf-btn{position:relative;overflow:hidden;border:0;border-radius:12px;background:var(--grad,#6366f1);color:#fff;font:700 15.5px var(--font-display,inherit);padding:13px 28px;cursor:pointer;display:inline-flex;align-items:center;gap:9px;box-shadow:0 8px 22px -8px var(--glow,rgba(99,102,241,.55));transition:transform .18s var(--ease,ease),box-shadow .18s,filter .18s}
.cf-btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 14px 30px -10px var(--glow,rgba(99,102,241,.6))}
.cf-btn:active:not(:disabled){transform:translateY(0) scale(.98)}
.cf-btn:disabled{cursor:not-allowed;filter:saturate(.5) opacity(.75)}
.cf-btn .ink{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);animation:cfInk .6s var(--ease,ease) forwards;pointer-events:none}
@keyframes cfInk{to{transform:scale(2.6);opacity:0}}
.cf-spin{width:17px;height:17px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:cfSpin .7s linear infinite;display:none}
@keyframes cfSpin{to{transform:rotate(360deg)}}
.cf.is-sending .cf-spin{display:block}
.cf.is-sending .cf-btn-ico{display:none}
.cf-hint{font-size:13px;color:var(--ink-3,#888)}

/* Result banners */
.cf-alert{display:none;align-items:flex-start;gap:10px;margin-top:16px;padding:13px 16px;border-radius:12px;font-size:14px;line-height:1.6;border:1px solid var(--cf-err);background:color-mix(in srgb,var(--cf-err) 9%,transparent);color:var(--ink,#111)}
.cf.is-error .cf-alert{display:flex;animation:cfShake .45s var(--ease,ease)}
@keyframes cfShake{10%,90%{transform:translateX(-2px)}30%,70%{transform:translateX(4px)}50%{transform:translateX(-4px)}}

/* Success takeover */
.cf-done{display:none;text-align:center;padding:44px 24px 48px}
.cf.is-done .cf-done{display:block;animation:cfRise .5s var(--ease,ease) both}
.cf.is-done .cf-body{display:none}
@keyframes cfRise{from{opacity:0;transform:translateY(14px)}}
.cf-check{width:74px;height:74px;margin-bottom:16px}
.cf-check circle{fill:none;stroke:var(--cf-ok);stroke-width:2.5;stroke-dasharray:151;stroke-dashoffset:151;animation:cfDraw .6s var(--ease,ease) .1s forwards}
.cf-check path{fill:none;stroke:var(--cf-ok);stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:38;stroke-dashoffset:38;animation:cfDraw .35s var(--ease,ease) .55s forwards}
@keyframes cfDraw{to{stroke-dashoffset:0}}
.cf-done h3{font-family:var(--font-display,inherit);font-size:22px;margin:0 0 8px;color:var(--ink,#111)}
.cf-done p{margin:0 auto;max-width:420px;font-size:15px;color:var(--ink-2,#555)}
.cf-again{margin-top:20px;background:transparent;border:1px solid var(--border,#e8eaf2);color:var(--ink-2,#555);border-radius:10px;padding:9px 18px;font:600 14px var(--font-body,inherit);cursor:pointer;transition:border-color .18s,color .18s}
.cf-again:hover{border-color:var(--brand,#6366f1);color:var(--ink,#111)}

@media (max-width:560px){.cf-row{grid-template-columns:1fr;gap:0}.cf-body{padding:22px 17px 20px}}

/* Everything above is decoration. Someone who asked for less motion gets none of it. */
@media (prefers-reduced-motion:reduce){
  .cf-card::before{animation:none}
  .cf-chip,.cf-btn,.cf-f label,.cf-msg,.cf-card{transition:none}
  .cf-btn:hover:not(:disabled),.cf-btn:active:not(:disabled),.cf-chip:active{transform:none}
  .cf-btn .ink{display:none}
  .cf.is-done .cf-done,.cf.is-error .cf-alert{animation:none}
  .cf-check circle,.cf-check path{animation:none;stroke-dashoffset:0}
  .cf-spin{animation-duration:1.6s}
}
</style>`;

const form = `<section class="cf" id="cf" aria-labelledby="cfTitle">
  <div class="cf-card">
    <div class="cf-body">
      <div class="cf-head">
        <h3 id="cfTitle">Send us a message</h3>
        <p>Fill in the form below and it goes straight to the team's inbox.</p>
      </div>

      <form id="cfForm" novalidate>
        <div class="cf-topics" role="group" aria-label="What is this about">
          <button type="button" class="cf-chip" data-topic="question" aria-pressed="true">How to use it</button>
          <button type="button" class="cf-chip" data-topic="bug" aria-pressed="false">Report a bug</button>
          <button type="button" class="cf-chip" data-topic="feature" aria-pressed="false">Suggest a feature</button>
          <button type="button" class="cf-chip" data-topic="other" aria-pressed="false">Something else</button>
        </div>

        <div class="cf-row">
          <div class="cf-f" data-f="name">
            <input id="cfName" name="name" type="text" maxlength="80" autocomplete="name" required placeholder=" ">
            <label for="cfName">Your name</label>
            <span class="cf-msg" id="cfNameMsg"></span>
          </div>
          <div class="cf-f" data-f="email">
            <input id="cfEmail" name="email" type="email" maxlength="160" autocomplete="email" required placeholder=" ">
            <label for="cfEmail">Email to reply to</label>
            <span class="cf-msg" id="cfEmailMsg"></span>
          </div>
        </div>

        <div class="cf-f" data-f="message">
          <textarea id="cfMessage" name="message" maxlength="4000" required placeholder=" "></textarea>
          <label for="cfMessage">Message</label>
          <span class="cf-count" id="cfCount">0 / 4000</span>
          <span class="cf-msg" id="cfMessageMsg"></span>
        </div>

        <div class="cf-hp" aria-hidden="true">
          <label for="cfRef">Leave this field empty</label>
          <input id="cfRef" name="cf_ref_x" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
        </div>

        <div class="cf-actions">
          <button class="cf-btn" id="cfSubmit" type="submit">
            <span class="cf-spin" aria-hidden="true"></span>
            <svg class="cf-btn-ico" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            <span id="cfSubmitText">Send message</span>
          </button>
          <span class="cf-hint">We reply to the email address you enter.</span>
        </div>

        <div class="cf-alert" id="cfAlert" role="alert"></div>
        <p class="cf-msg" aria-live="polite" id="cfLive" style="opacity:1;color:var(--ink-3,#888)"></p>
      </form>

      <noscript><p style="margin-top:14px;font-size:14px">This form needs JavaScript. You can email <a href="mailto:hello@blogkub.com">hello@blogkub.com</a> directly instead.</p></noscript>
    </div>

    <div class="cf-done" id="cfDone" role="status">
      <svg class="cf-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24"/><path d="M14 27l8 8 16-16"/></svg>
      <h3>Message sent</h3>
      <p>Thank you for getting in touch. We read every message and will reply to your email address as soon as we can.</p>
      <button class="cf-again" type="button" id="cfAgain">Send another</button>
    </div>
  </div>
</section>`;

const script = `<script>
(function () {
  var root = document.getElementById('cf');
  var form = document.getElementById('cfForm');
  if (!root || !form) return;

  // When the page finished rendering. The server rejects anything submitted within
  // three seconds of this, which no human beats and most bots do not clear.
  var born = Date.now();
  var topic = 'question';

  var els = {
    name: document.getElementById('cfName'),
    email: document.getElementById('cfEmail'),
    message: document.getElementById('cfMessage'),
    hp: document.getElementById('cfRef'),
    submit: document.getElementById('cfSubmit'),
    submitText: document.getElementById('cfSubmitText'),
    count: document.getElementById('cfCount'),
    alert: document.getElementById('cfAlert'),
    live: document.getElementById('cfLive'),
    done: document.getElementById('cfDone')
  };

  var MSG = {
    name: 'Please enter your name.',
    email: 'Please enter a valid email address.',
    message: 'That is a little short. Please write at least 10 characters.',
    network: 'Could not send. Please try again, or email hello@blogkub.com.',
    unconfigured: 'The mail system is not ready yet. Please email hello@blogkub.com directly.',
    invalid: 'Please check the details you entered.'
  };

  function field(name) { return form.querySelector('[data-f="' + name + '"]'); }
  function setBad(name, text) {
    var f = field(name); if (!f) return;
    f.classList.add('is-bad');
    var m = f.querySelector('.cf-msg'); if (m) m.textContent = text || '';
    var input = f.querySelector('input,textarea'); if (input) input.setAttribute('aria-invalid', 'true');
  }
  function clearBad(name) {
    var f = field(name); if (!f) return;
    f.classList.remove('is-bad');
    var m = f.querySelector('.cf-msg'); if (m) m.textContent = '';
    var input = f.querySelector('input,textarea'); if (input) input.removeAttribute('aria-invalid');
  }

  // Float the label once a field has content, so it does not drop back over the text.
  ['name', 'email', 'message'].forEach(function (k) {
    var input = els[k];
    var wrap = field(k);
    function sync() { wrap.classList.toggle('is-filled', input.value.length > 0); }
    input.addEventListener('input', function () {
      sync();
      clearBad(k);
      if (k === 'message') {
        var n = input.value.length;
        els.count.textContent = n + ' / 4000';
        els.count.classList.toggle('warn', n > 3800);
      }
    });
    input.addEventListener('blur', sync);
    sync();
  });

  // Topic chips
  form.querySelectorAll('.cf-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      topic = chip.dataset.topic;
      form.querySelectorAll('.cf-chip').forEach(function (c) {
        c.setAttribute('aria-pressed', String(c === chip));
      });
    });
  });

  // Ripple from the point of contact.
  els.submit.addEventListener('pointerdown', function (e) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var r = els.submit.getBoundingClientRect();
    var d = Math.max(r.width, r.height);
    var ink = document.createElement('span');
    ink.className = 'ink';
    ink.style.width = ink.style.height = d + 'px';
    ink.style.left = (e.clientX - r.left - d / 2) + 'px';
    ink.style.top = (e.clientY - r.top - d / 2) + 'px';
    els.submit.appendChild(ink);
    setTimeout(function () { ink.remove(); }, 620);
  });

  function validate() {
    var ok = true;
    if (!els.name.value.trim()) { setBad('name', MSG.name); ok = false; }
    if (!/^[^\\s@]+@[^\\s@.]+(\\.[^\\s@.]+)+$/.test(els.email.value.trim())) { setBad('email', MSG.email); ok = false; }
    if (els.message.value.trim().length < 10) { setBad('message', MSG.message); ok = false; }
    return ok;
  }

  function fail(text) {
    root.classList.remove('is-sending');
    root.classList.add('is-error');
    els.alert.textContent = text;
    els.submit.disabled = false;
    els.submitText.textContent = 'Send message';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    root.classList.remove('is-error');
    els.alert.textContent = '';
    if (!validate()) {
      var firstBad = form.querySelector('.is-bad input,.is-bad textarea');
      if (firstBad) firstBad.focus();
      return;
    }

    root.classList.add('is-sending');
    els.submit.disabled = true;
    els.submitText.textContent = 'Sending...';
    els.live.textContent = 'Sending your message';

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: els.name.value,
        email: els.email.value,
        message: els.message.value,
        hp: els.hp.value,
        topic: topic,
        t: born,
        page: location.pathname
      })
    }).then(function (res) {
      return res.json().then(function (data) { return { status: res.status, data: data }; });
    }).then(function (r) {
      root.classList.remove('is-sending');
      els.live.textContent = '';
      if (r.data && r.data.ok) {
        root.classList.add('is-done');
        document.getElementById('cf').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
      if (r.data && r.data.error === 'unconfigured') return fail(MSG.unconfigured);
      if (r.data && r.data.error === 'invalid') {
        (r.data.fields || []).forEach(function (f) { setBad(f, MSG[f] || MSG.invalid); });
        return fail(MSG.invalid);
      }
      fail(MSG.network);
    }).catch(function () {
      els.live.textContent = '';
      fail(MSG.network);
    });
  });

  document.getElementById('cfAgain').addEventListener('click', function () {
    form.reset();
    ['name', 'email', 'message'].forEach(function (k) { clearBad(k); field(k).classList.remove('is-filled'); });
    els.count.textContent = '0 / 4000';
    els.count.classList.remove('warn');
    els.submit.disabled = false;
    els.submitText.textContent = 'Send message';
    born = Date.now();
    root.classList.remove('is-done');
    els.name.focus();
  });
})();
</script>`;

const body = `<main class="wrap"><article class="doc">
<nav class="crumb"><a href="/en/">Home</a> › <span>Contact</span></nav>
<span class="pill">Contact</span>
<h1>Have a question, or want to <span class="g">suggest a feature</span>?</h1>
<p class="lead">We are always happy to hear from you, whether you need help using a feature, want to report something that went wrong, have an idea for a new block, or want to talk about working together. The BlogKub team reads every message and does its best to reply quickly.</p>

${styles}
${form}

<h2>Other ways to reach us</h2>
<div class="channels">
  <div class="ch"><div class="ic">✉️</div><b>Email</b><a href="mailto:hello@blogkub.com">hello@blogkub.com</a></div>
  <div class="ch"><div class="ic">💬</div><b>Facebook</b><a href="https://www.facebook.com/patpisan" target="_blank" rel="noopener">Founder (Ben)</a></div>
  <div class="ch"><div class="ic">🗨️</div><b>Pantip</b><a href="https://pantip.com/profile/2448725" target="_blank" rel="noopener">LuMoo</a></div>
  <div class="ch"><div class="ic">📚</div><b>Learning Center</b><a href="/en/learn/">Read the guides</a></div>
  <div class="ch"><div class="ic">🛠️</div><b>Try the tool</b><a href="/builder">Open BlogKub Builder</a></div>
</div>

<h2>What you can reach us about</h2>
<ul>
  <li><strong>How to use it</strong>: you are not sure how a feature works, or whether BlogKub can do what you have in mind.</li>
  <li><strong>Report a bug</strong>: you found an error, an exported file that misbehaves, or something that renders incorrectly.</li>
  <li><strong>Suggest a feature</strong>: you would like to see a new block, template, or capability added to BlogKub.</li>
  <li><strong>Partnerships and everything else</strong>: press, collaboration, or general feedback of any kind.</li>
</ul>

<h2>Try these first</h2>
<p>Most how-to questions already have an answer in the <a href="/en/learn/">Learning Center</a>, which collects a step-by-step guide for every feature with screenshots and worked examples, such as the <a href="/en/learn/toc">automatic table of contents</a>, <a href="/en/learn/dark-mode">dark mode</a>, the <a href="/en/learn/aeo">AEO summary box</a>, and <a href="/en/learn/templates">choosing a template</a>. For deeper guides on ranking your blog on Google and earning from it, read <a href="/en/blog/">our blog</a>.</p>

<h2>Response times</h2>
<p>BlogKub is run by a small team. We read everything and aim to reply within a reasonable window, though it can take a little longer during busy periods. Describing your problem clearly, with a screenshot if you have one, helps us help you faster.</p>

<div class="note">Thank you for using and supporting BlogKub. Every piece of feedback pushes us to make the tool better.</div>
</article></main>
${script}`;
---
<EnLayout seo={seo} thHref="/contact">
  <Fragment set:html={body} />
</EnLayout>
