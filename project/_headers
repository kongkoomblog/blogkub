  Content-Type: text/plain; charset=utf-8

# --- Plain text needs an explicit charset ---
# Workers Static Assets drops "; charset=utf-8" from Content-Type on deploy, though
# local wrangler and Cloudflare Pages both keep it (workers-sdk issue #9599). HTML,
# XML and JSON carry their own encoding declaration so they survive, but a .txt file
# has nothing in-band, and X-Content-Type-Options: nosniff below stops the browser
# guessing. The result was llms.txt rendering its Thai as mojibake. Set it by hand.
# Only llms.txt actually contains non-ASCII today; the other two are listed so the
# same bug does not come back the day someone adds a Thai comment to them.
/robots.txt
  Content-Type: text/plain; charset=utf-8
/ads.txt
  Content-Type: text/plain; charset=utf-8

# --- Internal PDFs: served, but never indexed ---
# project/uploads/ holds 45 internal design and feasibility documents that deploy
# with the rest of the site, so they are fetchable at /uploads/<name>.pdf. Nothing
# links to them, but "unlinked" is not "unfindable": a PDF can be indexed from an
# external link, a shared URL, or a crawler that guesses.
#
# X-Robots-Tag rather than a robots.txt Disallow, for two reasons. A Disallow stops
# the crawl, and a page that is never crawled is never told to leave the index, so a
# PDF that somehow got in would be stuck there; noindex needs the fetch to succeed to
# work. And robots.txt is public, so a Disallow line would advertise the very path it
# is trying to keep quiet. PDFs have no <head>, so a response header is the only way
# to mark them at all.
#
# The wildcard is at the END of the path. One that is not (/*.md) has already failed
# two deploys; see CLAUDE.md.
/uploads/*
  X-Robots-Tag: noindex, nofollow, noarchive

# --- Search engine ownership proof ---
# Yandex checks this file byte for byte, so the file itself must not be edited.
# It is 30 characters of text with no title and no canonical, which is exactly
# the kind of page that should never reach an index. Keeping it out via a
# response header leaves the file untouched and the verification intact.
/yandex_79b68877ecfa0831.html
  X-Robots-Tag: noindex, nofollow

# --- Link headers on the two homepages (RFC 8288) ---
# An agent that only issues a HEAD request never sees the <link> elements in <head>.
# These headers carry the same relations in the response itself, so the site is
# navigable without parsing HTML. Every relation used here is in the IANA registry.
#
# Only registered relations, and only resources that exist. The scanner that asked for
# this suggests rel="api-catalog" and rel="service-doc"; both are omitted because this
# site has no API to describe, and advertising an endpoint that 404s is worse than
# advertising nothing.
#
# All values live in ONE Link header per rule, comma separated as RFC 8288 allows. A
# second `Link:` line under the same rule, or a Link on /* as well as /, would leave it
# to the asset server whether the values merge or the last one wins. One line has no
# such question.
#
# Absolute URLs, and they must keep matching the <link> tags that build-hreflang.mjs
# writes into these two pages. If the hreflang set changes, change it here too.
/
  Link: <https://www.blogkub.com/>; rel="canonical", <https://www.blogkub.com/>; rel="alternate"; hreflang="th", <https://www.blogkub.com/en/>; rel="alternate"; hreflang="en", <https://www.blogkub.com/en/>; rel="alternate"; hreflang="x-default", <https://www.blogkub.com/llms.txt>; rel="describedby"; type="text/plain", <https://www.blogkub.com/rss.xml>; rel="alternate"; type="application/rss+xml"; title="BlogKub RSS", <https://www.blogkub.com/feed.json>; rel="alternate"; type="application/feed+json"; title="BlogKub JSON Feed", <https://www.blogkub.com/learn/>; rel="help", <https://www.blogkub.com/about>; rel="author", <https://www.blogkub.com/privacy>; rel="privacy-policy", <https://www.blogkub.com/terms>; rel="terms-of-service"

# /en and /en/ both listed: html_handling is left at its default, so the trailing slash
# is normalised by a redirect and either form can be the one that is served.
/en
  Link: <https://www.blogkub.com/en/>; rel="canonical", <https://www.blogkub.com/>; rel="alternate"; hreflang="th", <https://www.blogkub.com/en/>; rel="alternate"; hreflang="en", <https://www.blogkub.com/en/>; rel="alternate"; hreflang="x-default", <https://www.blogkub.com/llms.txt>; rel="describedby"; type="text/plain", <https://www.blogkub.com/en/rss.xml>; rel="alternate"; type="application/rss+xml"; title="BlogKub RSS", <https://www.blogkub.com/en/feed.json>; rel="alternate"; type="application/feed+json"; title="BlogKub JSON Feed", <https://www.blogkub.com/en/learn/>; rel="help", <https://www.blogkub.com/en/about>; rel="author", <https://www.blogkub.com/en/privacy>; rel="privacy-policy", <https://www.blogkub.com/en/terms>; rel="terms-of-service"
/en/
  Link: <https://www.blogkub.com/en/>; rel="canonical", <https://www.blogkub.com/>; rel="alternate"; hreflang="th", <https://www.blogkub.com/en/>; rel="alternate"; hreflang="en", <https://www.blogkub.com/en/>; rel="alternate"; hreflang="x-default", <https://www.blogkub.com/llms.txt>; rel="describedby"; type="text/plain", <https://www.blogkub.com/en/rss.xml>; rel="alternate"; type="application/rss+xml"; title="BlogKub RSS", <https://www.blogkub.com/en/feed.json>; rel="alternate"; type="application/feed+json"; title="BlogKub JSON Feed", <https://www.blogkub.com/en/learn/>; rel="help", <https://www.blogkub.com/en/about>; rel="author", <https://www.blogkub.com/en/privacy>; rel="privacy-policy", <https://www.blogkub.com/en/terms>; rel="terms-of-service"

# --- Everything else (HTML pages): always revalidate so edits show instantly ---
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
